---
const {title,description='Writing, photographs, and things I make.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} — notebrewer</title><meta name="description" content={description}/><link rel="icon" href="/favicon.svg"/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap"/></head><body><header><a class="brand" href="https://notebrewer.com/">notebrewer<span>.</span></a><nav aria-label="Main navigation"><a href="https://notebrewer.com/writing/">writing</a><a href="https://notebrewer.com/photos/">photos</a><a href="https://notebrewer.com/wallpapers/">wallpapers</a><a href="https://notebrewer.com/play/">play</a><a href="https://notebrewer.com/projects/">projects</a><a href="https://notebrewer.com/music/">music</a></nav><div class="profile-links"><a href="https://notebrewer.com/about/">about</a> / <a href="https://notebrewer.com/resume/">résumé ↗</a></div></header><main><slot/></main><footer><a href="https://notebrewer.com/">← back to the cube</a><span>Jonathan Brewer</span></footer></body></html>
<style is:global>
*{box-sizing:border-box}html{background:#fdfdfc;color:#252525;font-family:'Geist Mono',monospace}body{margin:0}a{color:inherit;text-underline-offset:5px}header{padding:32px 40px;display:flex;gap:24px;justify-content:space-between;align-items:center}.profile-links{font-size:12px;white-space:nowrap}.profile-links a{text-decoration:none}header{flex-wrap:wrap}.brand{text-decoration:none;letter-spacing:-.6px}.brand span{color:#999}nav{display:flex;gap:18px;flex-wrap:wrap;font-size:12px}nav a{text-decoration:none}nav a:hover{text-decoration:underline}main{max-width:760px;padding:65px 24px 90px;margin:auto;min-height:70vh}h1{font-size:clamp(28px,5vw,44px);font-weight:400;letter-spacing:-1.8px;line-height:1.25;margin:0 0 25px}h2{font-size:23px;font-weight:500;line-height:1.45;margin-top:2em}h3{line-height:1.5}p,li{font-size:16px;line-height:1.9}.meta{font-size:12px;color:#777;line-height:1.7}.intro{color:#666;max-width:650px}.entries{padding:20px 0;list-style:none}.entries li{border-top:1px solid #ddd;padding:25px 0}.entries h2{font-size:20px;margin:8px 0}.entries a{text-decoration:none}.entries a:hover{text-decoration:underline}.entries p{font-size:14px;margin:8px 0;color:#666}article img{max-width:100%;height:auto}article pre{overflow:auto;background:#f1f1f1;padding:18px;line-height:1.7;white-space:pre-wrap}article code{font-size:14px}article blockquote{margin:24px 0;border-left:2px solid #aaa;padding-left:20px;color:#666}article table{display:block;overflow:auto}article td,article th{padding:10px;border-bottom:1px solid #ddd}footer{flex-wrap:wrap;align-items:center;max-width:1100px;margin:auto;padding:30px 24px;display:flex;justify-content:space-between;gap:20px;font-size:12px;color:#777}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 22px;margin-top:40px}.gallery figure{margin:0}.gallery img{width:100%;height:360px;object-fit:cover;background:#eee}.gallery figcaption{font-size:13px;line-height:1.6;margin-top:10px}.gallery figcaption p{font-size:13px}.gallery figcaption a{display:inline-block;margin-top:8px}.button{display:inline-block;padding:14px 20px;background:#333;color:white;text-decoration:none;font-size:14px;margin:16px 12px 16px 0}a:focus-visible,button:focus-visible{outline:2px solid #777;outline-offset:5px}@media(max-width:700px){header{padding:24px;align-items:center;flex-direction:row;gap:22px 12px}header nav{order:3;width:100%}.profile-links{margin-left:auto}nav{gap:12px 18px}main{padding-top:35px}.gallery{grid-template-columns:1fr}.gallery img{height:auto}footer{font-size:11px}}
.coffee-link{display:inline-block;padding:12px 0;text-decoration:none}.coffee-link:hover{text-decoration:underline}
</style>
